# Configuración local. Copiá este archivo a `local.properties` y completá los valores.
# `local.properties` está gitignoreado y NO se commitea nunca — el repo es público.
#
# Usá barras normales en las rutas: en un archivo .properties el backslash es un carácter
# de escape y se come los separadores.

sdk.dir=C:/Users/<usuario>/AppData/Local/Android/Sdk

# Proyecto de Supabase. La anon key es pública por diseño (termina embebida en cualquier
# build de cliente), pero igual no se versiona.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_ANON_KEY=<tu-anon-key>
