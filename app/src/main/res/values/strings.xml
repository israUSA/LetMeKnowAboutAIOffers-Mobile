<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Student Offers</string>

    <!-- Header -->
    <!-- Wordmark partido en dos strings: "LetMeKnow" lleva el gradiente de marca y
         "AboutStudentOffers" va en color de texto normal. No reusar app_name, que es corto
         a propósito para el launcher y no representa el wordmark completo. -->
    <string name="wordmark_brand">LetMeKnow</string>
    <string name="wordmark_rest">AboutStudentOffers</string>
    <!-- La campana del header es el interruptor global de avisos. El estado va aparte del
         nombre porque se anuncia como stateDescription, no como parte de la etiqueta. -->
    <string name="alerts_button_description">Avisos de ofertas nuevas</string>
    <string name="alerts_button_state_on">Activados</string>
    <string name="alerts_button_state_off">Desactivados</string>

    <!-- Hero -->
    <!-- Entrecomillado a propósito: sin las comillas, aapt recorta el espacio final y el
         título queda pegado como "Ofertas de IAverificadas". -->
    <string name="hero_title_prefix">"Ofertas Tech "</string>
    <string name="hero_title_gradient">verificadas</string>
    <string name="hero_subtitle">Herramientas, créditos y recursos gratuitos para estudiantes, todo en un solo lugar.</string>
    <string name="search_field_placeholder">Buscar por empresa u oferta…</string>
    <plurals name="hero_badge_verified_count">
        <item quantity="one">%d oferta verificada</item>
        <item quantity="other">%d ofertas verificadas</item>
    </plurals>

    <!-- Filtros -->
    <string name="filter_tab_all">Todas</string>
    <string name="filter_tab_permanent">Permanentes</string>
    <string name="filter_tab_limited">Por tiempo limitado</string>

    <!-- Estado de error -->
    <string name="error_missing_config_title">Falta configuración</string>
    <string name="error_missing_config_body">Faltan estas claves en local.properties: %1$s. Agrégalas y vuelve a compilar la app.</string>
    <string name="error_network_title">Sin conexión</string>
    <string name="error_network_body">No pudimos conectarnos a internet. Revisa tu conexión e intenta de nuevo.</string>
    <string name="error_http_title">El servidor no respondió bien</string>
    <string name="error_http_body">Recibimos un error del servidor (código %1$d). Intenta de nuevo en unos minutos.</string>
    <string name="error_malformed_title">Respuesta inesperada</string>
    <string name="error_malformed_body">Los datos que llegaron no tienen el formato esperado. Intenta de nuevo más tarde.</string>
    <string name="error_retry">Reintentar</string>

    <!-- Estado vacío -->
    <string name="empty_state_title">Sin resultados</string>
    <string name="empty_state_body">No encontramos ofertas para esta búsqueda o filtro. Prueba con otro término o cambia de tab.</string>

    <!-- Canales de notificación -->
    <string name="channel_new_promos_name">Ofertas nuevas</string>
    <string name="channel_new_promos_description">Avisos cuando aparecen ofertas que no estaban la última vez que miramos.</string>

    <!-- Notificaciones -->
    <string name="notification_new_promos_title">Ofertas nuevas</string>
    <string name="notification_new_promos_single">%1$s sumó una oferta: «%2$s».</string>
    <plurals name="notification_new_promos_body">
        <item quantity="one">Hay %d oferta nueva en el catálogo.</item>
        <item quantity="other">Hay %d ofertas nuevas en el catálogo.</item>
    </plurals>

    <!-- Confirmación del interruptor de avisos -->
    <string name="notifications_enabled_snackbar">Te avisaremos de nuevas ofertas</string>
    <string name="notifications_disabled_snackbar">Notificaciones desactivadas</string>

    <!-- Footer -->
    <string name="footer_disclaimer">Las ofertas pueden cambiar sin aviso. Verifica siempre los detalles en el sitio oficial de cada empresa.</string>
</resources>
